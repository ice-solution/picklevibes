{
  "name": "PickleVibes WA Echo (Meta Cloud)",
  "meta": {
    "templateCredsSetupCompleted": false,
    "description": "Meta WhatsApp Cloud webhook verify + echo reply. Import into n8n, set env vars, point Meta Callback URL here."
  },
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "whatsapp-cloud",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "wh-get",
      "name": "Webhook GET Verify",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "pv-wa-echo-get"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.query['hub.mode'] }}",
              "rightValue": "subscribe",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "c2",
              "leftValue": "={{ $json.query['hub.verify_token'] }}",
              "rightValue": "={{ $env.WHATSAPP_WEBHOOK_VERIFY_TOKEN }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-verify",
      "name": "IF Verify OK",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $('Webhook GET Verify').item.json.query['hub.challenge'] }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "respond-challenge",
      "name": "Respond Challenge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [500, -80]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "Forbidden",
        "options": {
          "responseCode": 403
        }
      },
      "id": "respond-forbid",
      "name": "Respond 403",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [500, 80]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-cloud",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "wh-post",
      "name": "Webhook POST Messages",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 320],
      "webhookId": "pv-wa-echo-post"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "respond-200",
      "name": "Respond 200 ASAP",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [240, 320]
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.seenIds) staticData.seenIds = {};\n\nconst messages = [];\nfor (const entry of body.entry || []) {\n  for (const change of entry.changes || []) {\n    const value = change.value || {};\n    for (const msg of value.messages || []) {\n      if (staticData.seenIds[msg.id]) continue;\n      staticData.seenIds[msg.id] = Date.now();\n      let text = null;\n      if (msg.type === 'text') text = msg.text?.body || null;\n      if (msg.type === 'button') text = msg.button?.text || msg.button?.payload || null;\n      if (msg.type === 'interactive') {\n        text = msg.interactive?.button_reply?.title\n          || msg.interactive?.list_reply?.title\n          || null;\n      }\n      if (!text) continue;\n      messages.push({\n        from: msg.from,\n        id: msg.id,\n        text: String(text).trim(),\n        timestamp: msg.timestamp,\n      });\n    }\n  }\n}\n\n// prune old dedupe keys (>1h)\nconst cutoff = Date.now() - 3600_000;\nfor (const [k, ts] of Object.entries(staticData.seenIds)) {\n  if (ts < cutoff) delete staticData.seenIds[k];\n}\n\nif (!messages.length) {\n  return [];\n}\nreturn messages.map((m) => ({ json: m }));"
      },
      "id": "parse-msg",
      "name": "Parse + Dedupe Messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/{{ $env.WHATSAPP_API_VERSION || 'v21.0' }}/{{ $env.WHATSAPP_PHONE_NUMBER_ID }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.WHATSAPP_CLOUD_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $json.from }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"Echo: {{ $json.text }}\"\n  }\n}",
        "options": {}
      },
      "id": "send-echo",
      "name": "Send Echo via Cloud API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 320]
    }
  ],
  "connections": {
    "Webhook GET Verify": {
      "main": [[{ "node": "IF Verify OK", "type": "main", "index": 0 }]]
    },
    "IF Verify OK": {
      "main": [
        [{ "node": "Respond Challenge", "type": "main", "index": 0 }],
        [{ "node": "Respond 403", "type": "main", "index": 0 }]
      ]
    },
    "Webhook POST Messages": {
      "main": [[{ "node": "Respond 200 ASAP", "type": "main", "index": 0 }]]
    },
    "Respond 200 ASAP": {
      "main": [[{ "node": "Parse + Dedupe Messages", "type": "main", "index": 0 }]]
    },
    "Parse + Dedupe Messages": {
      "main": [[{ "node": "Send Echo via Cloud API", "type": "main", "index": 0 }]]
    }
  }
}
