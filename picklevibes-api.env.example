# PickCourt → PickleVibes 場地空缺整合（server .env）
#
# 設定後，GET /api/platform/search/courts 會向 PickleVibes 查可用時段；
# 留空則沿用本地 Mongo（同 DB 開發模式）。

# PickleVibes API 根路徑（必須可被 PickCourt server 存取）
# PICKLEVIBES_API_BASE_URL=https://picklevibes.hk/api

# 同機 UAT 建議用本機回環（避免 Cloudflare hairpin 令 POST /bot/booking 卡住→502）
# PickleVibes UAT 預設 PORT=5009（見 ecosystem.config.uat.js）
# PICKLEVIBES_API_INTERNAL_URL=http://127.0.0.1:5009/api

# 對應 main 的 BOT_API_KEY；有值時每店用 GET /api/bot/availability（較快）
# PICKLEVIBES_BOT_API_KEY=

# 遠端失敗時 fallback 本地 Mongo 查詢（1 / true 開啟）
# PICKLEVIBES_AVAILABILITY_FALLBACK_LOCAL=1

# 可選：逾時與並發
# PICKLEVIBES_API_TIMEOUT_MS=15000
# PICKLEVIBES_SEARCH_STORE_CONCURRENCY=4
# PICKLEVIBES_SEARCH_COURT_CONCURRENCY=8
