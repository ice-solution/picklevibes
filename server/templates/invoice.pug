doctype html
html(lang="zh-Hant")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title Invoice · PickleVibes · #{invoiceData.invoiceNumber}
    style.
      :root {
        --bg: #fdf2f8;
        --paper: #ffffff;
        --ink: #1a1020;
        --muted: #6b5a66;
        --line: #f3d4e4;
        --accent: #ec4899;
        --accent-deep: #db2777;
        --secondary: #14b8a6;
        --secondary-deep: #0d9488;
        --highlight: #f59e0b;
        --accent-soft: #fce7f3;
        --secondary-soft: #ccfbf1;
        --paid: #0f766e;
        --paid-soft: #ccfbf1;
        --display: "PickleVibes CJK", "Noto Sans TC", "Noto Sans CJK TC", "PingFang TC", "Microsoft JhengHei", sans-serif;
        --body: "PickleVibes CJK", "Noto Sans TC", "Noto Sans CJK TC", "PingFang TC", "Microsoft JhengHei", sans-serif;
        --mono: "PickleVibes CJK", "Noto Sans TC", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--bg); color: var(--ink); font-family: var(--body); font-size: 13.5px; line-height: 1.55; -webkit-font-smoothing: antialiased; }
      .sheet { width: 210mm; max-width: 100%; margin: 0 auto; background: var(--paper); padding: 18mm 16mm; border: 1px solid var(--line); }
      header.brandbar { display: grid; grid-template-columns: 1fr auto; gap: 24px; align-items: flex-start; padding-bottom: 22px; border-bottom: 3px solid transparent; border-image: linear-gradient(90deg, var(--accent) 0%, var(--secondary) 55%, var(--highlight) 100%) 1; }
      .brand { display: flex; align-items: center; gap: 12px; }
      .brand-mark { width: 48px; height: 48px; border-radius: 12px; overflow: hidden; background: #000; color: white; display: inline-flex; align-items: center; justify-content: center; font-size: 15px; font-weight: 700; }
      .brand-mark img { width: 48px; height: 48px; object-fit: contain; background: #000; }
      .brand-name { font-size: 20px; font-weight: 800; letter-spacing: -0.02em; }
      .brand-name .pickle { color: var(--accent); }
      .brand-name .vibes { color: var(--secondary); }
      .brand-meta { font-size: 12px; color: var(--muted); margin-top: 2px; }
      .invoice-block { text-align: right; }
      .invoice-label { font-family: var(--mono); font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.14em; color: var(--accent); font-weight: 600; }
      .invoice-num { font-family: var(--mono); font-size: 22px; font-weight: 700; letter-spacing: -0.02em; margin: 6px 0; color: var(--ink); }
      .invoice-dates { font-size: 12.5px; color: var(--muted); }
      .invoice-dates strong { color: var(--ink); font-weight: 600; }
      .status-pill { display: inline-block; margin-top: 8px; padding: 3px 10px; border-radius: 999px; background: var(--paid-soft); color: var(--paid); font-family: var(--mono); font-size: 10.5px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; }
      .parties { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; padding: 24px 0; }
      .party h4 { font-family: var(--mono); font-size: 10.5px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--secondary-deep); margin: 0 0 8px; font-weight: 500; }
      .party .name { font-size: 16px; font-weight: 700; margin-bottom: 4px; }
      .party .lines { font-size: 12.5px; color: var(--muted); line-height: 1.65; }
      .ref-strip { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; padding: 14px 18px; background: linear-gradient(90deg, var(--accent-soft), var(--secondary-soft)); border-radius: 6px; margin-bottom: 28px; border: 1px solid #f9a8d4; }
      .ref-strip .label { font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accent-deep); margin-bottom: 4px; font-weight: 600; }
      .ref-strip .value { font-size: 13px; font-weight: 500; }
      table { width: 100%; border-collapse: collapse; }
      thead th { text-align: left; padding: 10px; border-bottom: 2px solid var(--ink); font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); font-weight: 500; }
      tbody td { padding: 13px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
      td.desc strong { display: block; font-weight: 600; margin-bottom: 3px; }
      td.desc small { display: block; color: var(--muted); font-size: 12px; }
      td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
      td.num { font-family: var(--mono); font-size: 12.5px; }
      .totals { display: grid; grid-template-columns: 1.35fr 1fr; gap: 22px; margin-top: 24px; align-items: flex-start; }
      .terms { font-size: 12px; color: var(--muted); padding: 14px 16px; background: var(--bg); border-radius: 6px; border-left: 3px solid var(--highlight); }
      .terms h5 { font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink); margin: 0 0 6px; font-weight: 600; }
      .totals-block { display: flex; flex-direction: column; gap: 4px; }
      .total-row { display: flex; justify-content: space-between; font-size: 13.5px; padding: 5px 0; font-variant-numeric: tabular-nums; }
      .total-row.muted { color: var(--muted); }
      .total-row.grand { padding: 12px 16px; background: linear-gradient(90deg, var(--accent-deep), var(--secondary)); color: white; border-radius: 6px; margin-top: 6px; font-size: 17px; font-weight: 700; align-items: center; }
      .pay { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 28px; padding: 18px; border: 1px solid var(--line); border-radius: 8px; background: #fffafc; }
      .pay h4 { font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--secondary-deep); margin: 0 0 10px; font-weight: 600; }
      .pay .row { display: flex; justify-content: space-between; gap: 12px; padding: 4px 0; font-size: 12.5px; }
      .pay .row span:last-child { font-family: var(--mono); font-size: 12px; text-align: right; word-break: break-all; }
      .signoff { margin-top: 36px; display: grid; grid-template-columns: 1fr auto; gap: 24px; align-items: end; padding-top: 20px; border-top: 1px solid var(--line); }
      .signoff p { margin: 0; font-size: 14px; color: var(--muted); font-style: italic; }
      .signature { text-align: right; }
      .signature .mark { font-size: 18px; font-weight: 800; }
      .signature .mark .pickle { color: var(--accent); }
      .signature .mark .vibes { color: var(--secondary); }
      .signature .name { font-size: 11.5px; color: var(--muted); padding-top: 6px; border-top: 1px solid var(--line); margin-top: 8px; }
      .footer-note { margin-top: 28px; font-size: 11px; color: var(--muted); text-align: center; }
      @media print {
        body { background: white; }
        .sheet { box-shadow: none; border: none; margin: 0; width: auto; padding: 0; }
      }
  body
    .sheet
      header.brandbar
        .brand
          .brand-mark
            if logoSrc
              img(src=logoSrc, alt="PickleVibes")
            else
              | PV
          div
            .brand-name
              span.pickle Pickle
              span.vibes Vibes
            .brand-meta 香港匹克球場地 · picklevibes.hk
        .invoice-block
          .invoice-label 發票 Invoice
          .invoice-num= invoiceData.invoiceNumber
          .invoice-dates
            strong 發出 Issued
            |  
            span= issueDate
          .status-pill 已付款 Paid

      section.parties
        .party
          h4 由 From
          .name PickleVibes HK
          .lines
            | picklevibes.hk
            br
            | info@picklevibes.hk
            br
            | +852 6190-2761
        .party
          h4 帳單收件人 Bill to
          .name= userData.name || '客戶'
          .lines
            if userData.email
              | #{userData.email}
              br
            if userData.phone
              | #{userData.phone}
              br
            if userData.address
              | #{userData.address}

      .ref-strip
        div
          .label 狀態 Status
          .value 已付款 / Paid
        div
          .label 幣別 Currency
          .value HKD
        div
          .label 參考 Reference
          .value= invoiceData.reference || invoiceData.invoiceNumber

      table
        thead
          tr
            th 項目說明 Description
            th.num 數量 Qty
            th.num 單價 Unit
            th.num 金額 Amount
        tbody
          each item in invoiceData.items
            tr
              td.desc
                strong= item.description
                if item.details
                  small= item.details
              td.num= item.quantity
              td.num= formatCurrency(item.unitPrice)
              td.num= formatCurrency(item.total)

      .totals
        .terms
          h5 付款條款 Payment terms
          | 此發票確認付款已完成。金額以港元（HKD）計算。如有疑問請聯絡 info@picklevibes.hk。
          br
          | This invoice confirms payment received. Amounts in HKD. Contact info@picklevibes.hk with questions.
        .totals-block
          .total-row
            span 小計 Subtotal
            span= formatCurrency(invoiceData.subtotal)
          .total-row.muted
            span 稅項 Tax
            span= formatCurrency(0)
          .total-row.grand
            span 應付總額 Total
            span= formatCurrency(invoiceData.total)

      if paymentData
        .pay
          div
            h4 付款詳情 Payment details
            .row
              span 付款方式 Method
              span= paymentMethodLabel
            .row
              span 貨幣 Currency
              span HKD
            .row
              span 狀態 Status
              span Paid · 已付款
          div
            h4 交易紀錄 Transaction
            if paymentData.transactionId
              .row
                span 交易編號 Txn ID
                span= paymentData.transactionId
            .row
              span 發票編號 Invoice
              span= invoiceData.invoiceNumber
            if paymentData.paidAt
              .row
                span 付款時間 Paid at
                span= formatDate(paymentData.paidAt)

      .signoff
        p
          | 感謝您選擇 PickleVibes — 期待在球場見！
          br
          | Thank you for choosing PickleVibes. See you on court.
        .signature
          .mark
            span.pickle Pickle
            span.vibes Vibes
          .name PickleVibes HK · Billing

      p.footer-note Questions? info@picklevibes.hk · picklevibes.hk
